<Window x:Class="JSWorkPartner.CSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JSWorkPartner C#" Height="760" Width="1180"
        MinHeight="620" MinWidth="940" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#D1D5DB" BorderThickness="1"
                CornerRadius="8" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="FormHeading" Text="새 퀘스트" FontSize="22"
                               FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="제목" />
                    <TextBox x:Name="TitleBox" MaxLength="300" />
                    <TextBlock Text="상세 설명" />
                    <TextBox x:Name="DetailsBox" Height="120" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="외부 링크" />
                    <TextBox x:Name="ExternalUrlBox" />
                    <TextBlock Text="중요도" />
                    <ComboBox x:Name="ImportanceBox" SelectedIndex="0">
                        <ComboBoxItem Content="★ (1)" Tag="1" />
                        <ComboBoxItem Content="★★ (2)" Tag="2" />
                        <ComboBoxItem Content="★★★ (3)" Tag="3" />
                        <ComboBoxItem Content="★★★★ (4)" Tag="4" />
                        <ComboBoxItem Content="★★★★★ (5)" Tag="5" />
                    </ComboBox>
                    <CheckBox x:Name="HasDeadlineBox" Content="마감일 설정"
                              Checked="DeadlineToggleChanged" Unchecked="DeadlineToggleChanged"
                              Margin="0,4" />
                    <DatePicker x:Name="DeadlinePicker" IsEnabled="False" Margin="0,4,0,12" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelEditButton" Content="수정 취소"
                                Visibility="Collapsed" Click="CancelEdit_Click" />
                        <Button x:Name="SaveButton" Content="저장" Background="{StaticResource AccentBrush}"
                                Foreground="White" FontWeight="SemiBold" Click="Save_Click" />
                    </StackPanel>
                    <Separator Margin="0,14,0,10" />
                    <TextBlock Text="데이터 파일" FontWeight="SemiBold" />
                    <TextBlock x:Name="DatabasePathText" TextWrapping="Wrap" Foreground="#4B5563"
                               Margin="0,5,0,5" />
                    <Button Content="저장 위치 열기" HorizontalAlignment="Left"
                            Click="OpenDataFolder_Click" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="퀘스트 보드" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock x:Name="SummaryText" Foreground="#4B5563" Margin="0,3,0,0" />
                </StackPanel>
                <Button Content="새로 고침" DockPanel.Dock="Right" HorizontalAlignment="Right"
                        Click="Refresh_Click" />
            </DockPanel>

            <TabControl x:Name="TaskTabs" Grid.Row="1" SelectionChanged="TaskTabs_SelectionChanged">
                <TabItem x:Name="PendingTab" Header="진행 중">
                    <DataGrid x:Name="PendingGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="Grid_SelectionChanged"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="55" />
                            <DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="상세 설명" Binding="{Binding Details}" Width="2*" />
                            <DataGridTextColumn Header="중요도" Binding="{Binding ImportanceDisplay}" Width="90" />
                            <DataGridTextColumn Header="마감일" Binding="{Binding DeadlineDisplay}" Width="100" />
                            <DataGridTextColumn Header="접수 시각" Binding="{Binding DateDisplay}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem x:Name="CompletedTab" Header="완료">
                    <DataGrid x:Name="CompletedGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="Grid_SelectionChanged"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="55" />
                            <DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="상세 설명" Binding="{Binding Details}" Width="2*" />
                            <DataGridTextColumn Header="중요도" Binding="{Binding ImportanceDisplay}" Width="90" />
                            <DataGridTextColumn Header="마감일" Binding="{Binding DeadlineDisplay}" Width="100" />
                            <DataGridTextColumn Header="완료 시각" Binding="{Binding DateDisplay}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <DockPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock x:Name="SelectedTaskText" Text="퀘스트를 선택하세요."
                           VerticalAlignment="Center" Foreground="#4B5563" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="링크 열기" Click="OpenLink_Click" />
                    <Button Content="복제" Click="Duplicate_Click" />
                    <Button Content="수정" Click="Edit_Click" />
                    <Button Content="삭제" Click="Delete_Click" />
                    <Button x:Name="TransitionButton" Content="완료" Click="Transition_Click"
                            Background="{StaticResource AccentBrush}" Foreground="White" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
