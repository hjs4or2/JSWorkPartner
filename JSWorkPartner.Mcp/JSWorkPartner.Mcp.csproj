<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <RuntimeFrameworkVersion>8.0.31</RuntimeFrameworkVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="verification/**" />
    <PackageReference Include="ModelContextProtocol" Version="[2.2.0]" />
    <Compile Include="../JSWorkPartner.CSharp/Data/NativeSqlite.cs" Link="Shared/NativeSqlite.cs" />
    <Compile Include="../JSWorkPartner.CSharp/Data/TaskRepository.cs" Link="Shared/TaskRepository.cs" />
    <Compile Include="../JSWorkPartner.CSharp/Models/TaskItem.cs" Link="Shared/TaskItem.cs" />
    <Compile Include="../JSWorkPartner.CSharp/Services/TaskService.cs" Link="Shared/TaskService.cs" />
  </ItemGroup>
</Project>
